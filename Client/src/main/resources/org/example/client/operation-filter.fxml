<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox xmlns:fx="http://javafx.com/fxml"
      xmlns="http://javafx.com/javafx"
      fx:controller="org.example.client.controller.filter.OperationFilterController"
      spacing="0"
>

    <TitledPane fx:id="titledPane"
                text="Фильтры"
                expanded="false"
                style="-fx-background-color: transparent; -fx-border-color: transparent;">

        <font>
            <Font name="System Bold" size="14"/>
        </font>

        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Тип:"
                       minWidth="60"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #495057;"/>
                <ComboBox fx:id="typeFilterComboBox"
                          prefWidth="200"
                          promptText="Выберите тип"
                          style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-background-color: white; -fx-border-color: #ced4da; -fx-border-width: 1; -fx-padding: 2; -fx-font-size: 13px;">
                </ComboBox>
            </HBox>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Категория:"
                       minWidth="60"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #495057;"/>
                <ComboBox fx:id="categoryFilterComboBox"
                          prefWidth="200"
                          promptText="Все категории"
                          style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-background-color: white; -fx-border-color: #ced4da; -fx-border-width: 1; -fx-padding: 2; -fx-font-size: 13px;">
                </ComboBox>
            </HBox>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Дата:"
                       minWidth="60"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #495057;"/>
                <DatePicker fx:id="dateFromPicker"
                            promptText="С даты"
                            prefWidth="120"
                            style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-background-color: white; -fx-border-color: #ced4da; -fx-border-width: 1; -fx-font-size: 13px;"/>
                <Label text="—"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6c757d;"/>
                <DatePicker fx:id="dateToPicker"
                            promptText="По дату"
                            prefWidth="120"
                            style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-background-color: white; -fx-border-color: #ced4da; -fx-border-width: 1; -fx-font-size: 13px;"/>
                <Button fx:id="clearDateButton"
                        text="✕"
                        prefWidth="30"
                        style="-fx-background-color: #6c757d; -fx-background-radius: 15; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 12px;"
                        onAction="#handleClearDates">
                </Button>
            </HBox>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Сумма:"
                       minWidth="60"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #495057;"/>
                <TextField fx:id="minAmountField"
                           promptText="От"
                           prefWidth="95"
                           style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-background-color: white; -fx-border-color: #ced4da; -fx-border-width: 1; -fx-padding: 2 5 2 5; -fx-font-size: 13px;">
                </TextField>
                <Label text="—"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #6c757d;"/>
                <TextField fx:id="maxAmountField"
                           promptText="До"
                           prefWidth="95"
                           style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-background-color: white; -fx-border-color: #ced4da; -fx-border-width: 1; -fx-padding: 2 5 2 5; -fx-font-size: 13px;">
                </TextField>
            </HBox>

            <HBox spacing="15" alignment="CENTER">
                <Button fx:id="applyFiltersButton"
                        text="Применить"
                        prefWidth="150"
                        style="-fx-background-color: #28a745; -fx-background-radius: 20; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 15 8 15; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(40,167,69,0.3), 8, 0, 0, 2);"
                        onAction="#handleApplyFilters">
                </Button>

                <Button fx:id="clearFiltersButton"
                        text="Сбросить"
                        prefWidth="100"
                        style="-fx-background-color: #dc3545; -fx-background-radius: 20; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 15 8 15; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(220,53,69,0.3), 8, 0, 0, 2);"
                        onAction="#handleClearFilters">
                </Button>
            </HBox>
        </VBox>
    </TitledPane>
</VBox>