<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox xmlns:fx="http://javafx.com/fxml"
      xmlns="http://javafx.com/javafx"
      fx:controller="org.example.client.controller.BudgetController"
      style="-fx-background-color: linear-gradient(to bottom, #f8f9fa, #e9ecef);">

    <VBox fx:id="root" spacing="0" alignment="TOP_CENTER"
          style="-fx-background-color: white; -fx-background-radius: 15; -fx-border-radius: 15; -fx-border-color: #dee2e6; -fx-border-width: 1;"
          VBox.vgrow="ALWAYS">

        <fx:include source="navigation.fxml"/>

        <VBox spacing="25" alignment="CENTER" VBox.vgrow="ALWAYS">
            <padding>
                <Insets left="40" right="40" bottom="40"/>
            </padding>

            <VBox spacing="10" alignment="CENTER">
                <Label fx:id="balanceLabel"
                       style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
                       text="0.00 ₽">
                    <font>
                        <Font name="System Bold" size="36"/>
                    </font>
                </Label>
            </VBox>

            <Separator prefWidth="200" style="-fx-background-color: #dee2e6;"/>

            <VBox fx:id="inputBox" spacing="15" alignment="CENTER" maxWidth="300">
                <Label text="Введите сумму операции"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <HBox spacing="10" alignment="CENTER">
                    <Label text="Сумма:"
                           style="-fx-font-size: 14px; -fx-text-fill: #495057;"
                           minWidth="50"/>
                    <TextField fx:id="amountField"
                               promptText="0.00"
                               style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ced4da; -fx-border-width: 1; -fx-padding: 10; -fx-background-color: white; -fx-font-size: 14px;"
                               prefWidth="200"
                               maxWidth="200"/>
                </HBox>
            </VBox>

            <HBox fx:id="categoryBox" spacing="20" alignment="CENTER">
                <VBox spacing="5" alignment="CENTER">
                    <Label text="Категория дохода"
                           style="-fx-font-size: 12px; -fx-text-fill: #28a745; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="increaseCategoryComboBox"
                              promptText="Выберите категорию"
                              prefWidth="180"
                              style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-background-color: white; -fx-border-color: #ced4da; -fx-border-width: 1;"/>
                </VBox>

                <VBox spacing="5" alignment="CENTER">
                    <Label text="Категория расхода"
                           style="-fx-font-size: 12px; -fx-text-fill: #dc3545; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="decreaseCategoryComboBox"
                              promptText="Выберите категорию"
                              prefWidth="180"
                              style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-background-color: white; -fx-border-color: #ced4da; -fx-border-width: 1;"/>
                </VBox>
            </HBox>

            <HBox fx:id="buttonBox" spacing="20" alignment="CENTER">
                <Button fx:id="increaseButton"
                        text="Увеличить"
                        prefWidth="160"
                        style="-fx-background-color: #28a745; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 20 12 20; -fx-cursor: hand;"
                        onAction="#handleIncrease"/>

                <Button fx:id="decreaseButton"
                        text="Уменьшить"
                        prefWidth="160"
                        style="-fx-background-color: #dc3545; -fx-background-radius: 8; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 20 12 20; -fx-cursor: hand;"
                        onAction="#handleDecrease"/>
            </HBox>

            <Label fx:id="errorLabel"
                   wrapText="true"
                   style="-fx-text-fill: #dc3545; -fx-font-size: 13px; -fx-background-color: #f8d7da; -fx-background-radius: 5; -fx-padding: 8 15 8 15;"
                   visible="false"/>
        </VBox>
    </VBox>
</VBox>