<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" prefHeight="91.0" prefWidth="963.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.client.view.HeaderView">
   <children>
      <HBox alignment="CENTER_LEFT" maxHeight="70.0" maxWidth="1.7976931348623157E308" styleClass="header" HBox.hgrow="ALWAYS">
         <children>
               <Label styleClass="h1" text="Budget Accounting" />
            <Region maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </Region>
         
                      <HBox alignment="CENTER_LEFT" spacing="20">
               <ComboBox fx:id="currencyAmountComboBox" prefWidth="250.0" styleClass="amount-combo-box">
                  <cursor>
                     <Cursor fx:constant="HAND" />
                  </cursor>
               </ComboBox>
            
                                <HBox alignment="CENTER" fillHeight="false" spacing="12">
                     <Label fx:id="userNameLabel" styleClass="h3" text="Name" />
                  <Button fx:id="profileButton" maxHeight="-Infinity" maxWidth="-Infinity" mnemonicParsing="false" onAction="#handleProfileButton" prefHeight="40.0" prefWidth="40.0">
                     <graphic>
                           <ImageView fitHeight="31" fitWidth="31">
                               <Image url="https://storage.googleapis.com/tagjs-prod.appspot.com/v1/y4WrJYOO1d/9dg4ki2n_expires_30_days.png" />
                           </ImageView>
                     </graphic>
                     <styleClass>
                        <String fx:value="round-button" />
                        <String fx:value="light-round-button" />
                     </styleClass>
                  </Button>
                 </HBox>
               <HBox.margin>
                  <Insets />
               </HBox.margin>
             </HBox>
         </children>
         <HBox.margin>
            <Insets />
         </HBox.margin>
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" />
   </padding>
</HBox>
