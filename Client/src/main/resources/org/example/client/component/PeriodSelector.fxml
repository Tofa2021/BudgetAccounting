<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="6.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.client.view.PeriodSelectorView">
    <children>
        <Button fx:id="dayButton" mnemonicParsing="false" onAction="#handleDayButton" styleClass="operation-button" text="День" />
        <Button fx:id="weekButton" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#handleWeekButton" styleClass="operation-button" text="Неделя" />
        <Button fx:id="monthButton" layoutX="66.0" layoutY="10.0" mnemonicParsing="false" onAction="#handleMonthButton" styleClass="operation-button" text="Месяц" />
        <Button fx:id="yearButton" layoutX="122.0" layoutY="10.0" mnemonicParsing="false" onAction="#handleYearButton" styleClass="operation-button" text="Год" />
        <Button fx:id="allButton" layoutX="192.0" layoutY="10.0" mnemonicParsing="false" onAction="#handleAllButton" styleClass="operation-button" text="Все" />
