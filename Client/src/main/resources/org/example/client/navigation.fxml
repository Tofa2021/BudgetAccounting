<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Text?>
<HBox xmlns:fx="http://javafx.com/fxml"
      xmlns="http://javafx.com/javafx"
      fx:controller="org.example.client.controller.NavigationController"
      spacing="10"
      alignment="CENTER_LEFT"
      style="-fx-background-color: linear-gradient(to right, #2c3e50, #3498db);
             -fx-padding: 10 20 10 20;
             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 2);"
      prefHeight="60.0">

    <padding>
        <Insets top="5" right="5" bottom="5" left="5"/>
    </padding>

    <Text text="BudgetAccounting"
          style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2);"/>

    <Region HBox.hgrow="ALWAYS"/>

    <Button fx:id="openBudgetButton"
            style="-fx-background-color: rgba(255,255,255,0.2);
                   -fx-background-radius: 20;
                   -fx-text-fill: white;
                   -fx-font-size: 14px;
                   -fx-font-weight: bold;
                   -fx-padding: 8 15 8 15;
                   -fx-cursor: hand;"
            onAction="#handleOpenBudget">
        Бюджет
        <tooltip>
            <Tooltip text="Вернуться на главную страницу бюджета"/>
        </tooltip>
    </Button>

    <Button fx:id="openOperationHistoryButton"
            style="-fx-background-color: rgba(255,255,255,0.2);
                   -fx-background-radius: 20;
                   -fx-text-fill: white;
                   -fx-font-size: 14px;
                   -fx-font-weight: bold;
                   -fx-padding: 8 15 8 15;
                   -fx-cursor: hand;"
            onAction="#handleOpenOperationHistory">
        История операций
        <tooltip>
            <Tooltip text="Просмотр истории всех операций"/>
        </tooltip>
    </Button>

    <Button fx:id="openGraphicsButton"
            style="-fx-background-color: rgba(255,255,255,0.2);
                   -fx-background-radius: 20;
                   -fx-text-fill: white;
                   -fx-font-size: 14px;
                   -fx-font-weight: bold;
                   -fx-padding: 8 15 8 15;
                   -fx-cursor: hand;"
            onAction="#handleOpenGraphicsButton">
        График бюджета
        <tooltip>
            <Tooltip text="Просмотр графического представления бюджета"/>
        </tooltip>
    </Button>

    <!-- Кнопка выхода с иконкой -->
    <Button fx:id="logoutButton"
            style="-fx-background-color: #e74c3c;
                   -fx-background-radius: 20;
                   -fx-text-fill: white;
                   -fx-font-size: 14px;
                   -fx-font-weight: bold;
                   -fx-padding: 8 15 8 15;
                   -fx-cursor: hand;
                   -fx-effect: dropshadow(gaussian, rgba(231,76,60,0.4), 10, 0, 0, 2);"
            onAction="#handleLogout">
        Выйти
        <tooltip>
            <Tooltip text="Выйти из аккаунта"/>
        </tooltip>
    </Button>

</HBox>