<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml"
      xmlns="http://javafx.com/javafx"
      fx:controller="org.example.client.controller.PeriodSelectController"
      spacing="5">

    <padding>
        <Insets top="5" right="5" bottom="5" left="5"/>
    </padding>

    <Label text="Выберите период:" style="-fx-font-weight: bold;"/>

    <HBox spacing="5" alignment="CENTER_LEFT">
        <ToggleButton fx:id="weekButton" text="7 дней" onAction="#handlePeriodClick"/>
        <ToggleButton fx:id="monthButton" text="30 дней" onAction="#handlePeriodClick"/>
        <ToggleButton fx:id="threeMonthsButton" text="90 дней" onAction="#handlePeriodClick"/>
        <ToggleButton fx:id="halfYearButton" text="180 дней" onAction="#handlePeriodClick"/>
        <ToggleButton fx:id="yearButton" text="365 дней" onAction="#handlePeriodClick"/>
        <ToggleButton fx:id="allButton" text="Все" onAction="#handlePeriodClick"/>
    </HBox>

    <Label fx:id="periodInfoLabel" style="-fx-text-fill: #666666; -fx-font-size: 11px;"/>

</VBox>