<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.Scene?>
<?import javafx.scene.text.Font?>
<Scene xmlns:fx="http://javafx.com/fxml" width="800" height="600"
       xmlns="http://javafx.com/javafx"
       fx:controller="org.example.client.controller.RegistrationController">
    <VBox fx:id="root" spacing="20" alignment="CENTER">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <Label text="Регистрация">
            <font>
                <Font name="System Bold" size="24"/>
            </font>
        </Label>

        <HBox spacing="20" alignment="CENTER">
            <Label text="Логин: "/>
            <TextField fx:id="usernameField" promptText="Введите логин" maxWidth="150"/>
        </HBox>

        <HBox spacing="20" alignment="CENTER">
            <Label text="Пароль: "/>
            <PasswordField fx:id="passwordField" promptText="Введите пароль" maxWidth="150"/>
        </HBox>

        <Label fx:id="errorField" wrapText="true" style="-fx-text-fill: red;"/>

        <Button fx:id="signUpButton"
                text="Зарегистрироваться"
                prefWidth="150"
                style="-fx-background-color: blue; -fx-text-fill: white; -fx-font-size: 14px;"
                onAction="#handleSignUp"/>

        <HBox alignment="CENTER" spacing="5">
            <Label text="Уже есть аккаунт?" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            <Hyperlink fx:id="signUpLink"
                       text="Войти"
                       style="-fx-font-size: 12px; -fx-text-fill: #3498db; -fx-border-color: transparent;"
                       onAction="#handleSignInLink">
                <font>
                    <Font name="System Bold" size="12"/>
                </font>
            </Hyperlink>
        </HBox>

    </VBox>

</Scene>
