<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml"
      xmlns="http://javafx.com/javafx"
      fx:controller="org.example.client.controller.graphics.BudgetLineChartController"
      prefHeight="400.0"
      prefWidth="600.0"
      spacing="10"
      alignment="CENTER">

    <LineChart fx:id="lineChart"
               title="Накопленный баланс"
               prefHeight="380.0"
               prefWidth="580.0"
               createSymbols="false"
               animated="false"
    >

        <xAxis>
            <NumberAxis label="Дни"
                        tickUnit="1"
                        minorTickCount="0"
                        tickLabelRotation="45"/>
        </xAxis>

        <yAxis>
            <NumberAxis label="Сумма (руб)"/>
        </yAxis>

    </LineChart>

</VBox>