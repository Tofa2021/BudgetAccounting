<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.Scene?>
<?import javafx.scene.text.Font?>
<Scene xmlns:fx="http://javafx.com/fxml" width="800" height="600"
       xmlns="http://javafx.com/javafx"
       fx:controller="org.example.client.controller.OperationHistoryController">
    <VBox fx:id="root" spacing="20" alignment="CENTER">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <Label text="История операций">
            <font>
                <Font name="System Bold" size="24"/>
            </font>
        </Label>

        <TitledPane text="Фильтры" expanded="false">
            <VBox spacing="10">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Тип:" minWidth="80"/>
                    <ComboBox fx:id="typeFilterComboBox" prefWidth="150"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Категория:" minWidth="80"/>
                    <ComboBox fx:id="categoryFilterComboBox" prefWidth="150"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Дата:" minWidth="80"/>
                    <DatePicker fx:id="dateFromPicker" promptText="С даты" prefWidth="130"/>
                    <Label text="-"/>
                    <DatePicker fx:id="dateToPicker" promptText="По дату" prefWidth="130"/>
                    <Button fx:id="clearDateButton" text="✕" prefWidth="30"
                            style="-fx-background-color: #999; -fx-text-fill: white;"
                            onAction="#handleClearDates"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Сумма:" minWidth="80"/>
                    <TextField fx:id="minAmountField" promptText="От" prefWidth="100"/>
                    <Label text="-"/>
                    <TextField fx:id="maxAmountField" promptText="До" prefWidth="100"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="applyFiltersButton" text="Применить фильтры"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white;"
                            onAction="#handleApplyFilters"/>
                    <Button fx:id="clearFiltersButton" text="Сбросить все"
                            style="-fx-background-color: #999; -fx-text-fill: white;"
                            onAction="#handleClearFilters"/>
                    <Label fx:id="filterResultsLabel" style="-fx-font-style: italic; -fx-text-fill: #666;"/>
                </HBox>
            </VBox>
        </TitledPane>

        <VBox spacing="10" VBox.vgrow="NEVER">
            <Label text="Период:" style="-fx-font-weight: bold;"/>
            <HBox spacing="10" alignment="CENTER">
                <ToggleButton fx:id="weekButton" text="7 дней" prefWidth="80"
                              style="-fx-background-color: #e0e0e0; -fx-text-fill: black;"
                              focusTraversable="false" onAction="#handlePeriodClick"/>
                <ToggleButton fx:id="monthButton" text="30 дней" prefWidth="80"
                              style="-fx-background-color: #e0e0e0; -fx-text-fill: black;"
                              focusTraversable="false" onAction="#handlePeriodClick"/>
                <ToggleButton fx:id="threeMonthsButton" text="90 дней" prefWidth="80"
                              style="-fx-background-color: #e0e0e0; -fx-text-fill: black;"
                              focusTraversable="false" onAction="#handlePeriodClick"/>
                <ToggleButton fx:id="halfYearButton" text="Полгода" prefWidth="80"
                              style="-fx-background-color: #e0e0e0; -fx-text-fill: black;"
                              focusTraversable="false" onAction="#handlePeriodClick"/>
                <ToggleButton fx:id="yearButton" text="Год" prefWidth="80"
                              style="-fx-background-color: #e0e0e0; -fx-text-fill: black;"
                              focusTraversable="false" onAction="#handlePeriodClick"/>
                <ToggleButton fx:id="allButton" text="Все время" prefWidth="80"
                              style="-fx-background-color: #e0e0e0; -fx-text-fill: black;"
                              focusTraversable="false" onAction="#handlePeriodClick"/>
            </HBox>

            <Label fx:id="periodInfoLabel" style="-fx-font-style: italic; -fx-text-fill: #666;"/>
        </VBox>

        <TableView fx:id="operationTableView" VBox.vgrow="ALWAYS"/>

        <Button fx:id="openBudgetButton"
                text="Вернуться к Бюджету"
                prefWidth="150"
                style="-fx-background-color: blue; -fx-text-fill: white; -fx-font-size: 14px;"
                onAction="#handleOpenBudget"/>

        <Label fx:id="errorLabel" wrapText="true" style="-fx-text-fill: red;"/>
    </VBox>

</Scene>
