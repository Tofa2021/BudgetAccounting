<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.Scene?>
<?import javafx.scene.text.Font?>
<Scene xmlns:fx="http://javafx.com/fxml" width="500" height="250"
       xmlns="http://javafx.com/javafx"
       fx:controller="org.example.client.controller.OperationHistoryController">
    <VBox fx:id="root" spacing="20" alignment="CENTER">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <Label text="История операций">
            <font>
                <Font name="System Bold" size="24"/>
            </font>
        </Label>

        <TableView fx:id="operationTableView" VBox.vgrow="ALWAYS"/>

        <Button fx:id="openBudgetButton"
                text="Вернуться к Бюджету"
                prefWidth="150"
                style="-fx-background-color: blue; -fx-text-fill: white; -fx-font-size: 14px;"
                onAction="#handleOpenBudget"/>

        <Label fx:id="errorLabel" wrapText="true" style="-fx-text-fill: red;"/>
    </VBox>

</Scene>
