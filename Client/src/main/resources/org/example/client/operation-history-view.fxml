<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<VBox xmlns:fx="http://javafx.com/fxml"
      xmlns="http://javafx.com/javafx"
      fx:controller="org.example.client.controller.OperationHistoryController">
    <VBox fx:id="root" spacing="20" alignment="CENTER">

        <fx:include source="navigation.fxml"/>

        <Label text="История операций">
            <font>
                <Font name="System Bold" size="24"/>
            </font>
        </Label>

        <fx:include fx:id="operationFilterVBox" source="operation-filter.fxml"/>

        <fx:include fx:id="periodSelectVBox" source="period_select.fxml"/>

        <fx:include fx:id="operationTableVBox" source="operation-table.fxml"/>

        <Label fx:id="errorLabel" wrapText="true" style="-fx-text-fill: red;"/>
    </VBox>

</VBox>
