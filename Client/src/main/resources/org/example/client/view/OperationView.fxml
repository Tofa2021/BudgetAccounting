<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity"
      minWidth="-Infinity" spacing="40.0" styleClass="background" stylesheets="@../css/styles.css"
      xmlns="http://javafx.com/javafx/25" fx:controller="org.example.client.view.OperationView">
    <children>
        <HBox>
            <children>
                <Button fx:id="addButton" onAction="#handleAddButton" mnemonicParsing="false" text="Добавить операцию"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField promptText="Поиск..."/>
            </children>
        </HBox>
        <ListView fx:id="operationsList" prefHeight="547.0" prefWidth="893.0" styleClass="operations-list"/>
    </children>
    <padding>
        <Insets bottom="20.0" left="100.0" right="100.0" top="20.0"/>
    </padding>
</VBox>
