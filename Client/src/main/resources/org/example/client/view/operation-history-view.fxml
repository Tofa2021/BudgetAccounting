<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox xmlns:fx="http://javafx.com/fxml"
      xmlns="http://javafx.com/javafx"
      fx:controller="org.example.client.controller.OperationHistoryController"
      fx:id="root"
      style="-fx-background-color: linear-gradient(to bottom, #f8f9fa, #e9ecef);">

    <fx:include source="../navigation.fxml"/>

    <VBox spacing="25" alignment="TOP_CENTER" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="30" left="40" right="40" bottom="40"/>
        </padding>

        <Label text="История операций"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
            <font>
                <Font name="System Bold" size="28"/>
            </font>
        </Label>

        <VBox spacing="15" alignment="CENTER" maxWidth="800">
            <fx:include fx:id="operationFilterVBox" source="../operation-filter.fxml"/>
        </VBox>

        <VBox spacing="15" alignment="CENTER" maxWidth="600">
            <fx:include fx:id="periodSelectVBox" source="../period_select.fxml"/>
        </VBox>

        <VBox spacing="15" alignment="CENTER" maxWidth="900">
            <fx:include fx:id="operationTableVBox" source="../operation-table.fxml"/>
        </VBox>

        <Label fx:id="errorLabel"
               wrapText="true"
               style="-fx-text-fill: #dc3545; -fx-font-size: 13px; -fx-background-color: #f8d7da; -fx-background-radius: 5; -fx-padding: 8 15 8 15;"
               visible="false"/>
    </VBox>
</VBox>